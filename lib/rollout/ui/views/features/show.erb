<script>
    window.onload = () => {
        const percentInput = document.getElementById('percentage');
        const startingPercent = Number(percentInput.value);
        const cacheBreakToggle = document.getElementById('consumer_cache_break');
        const permanentToggle = document.getElementById('permanent');
        const descriptionInput = document.getElementById('description');
        const form = document.getElementById('updateFormSubmit');
        const featureName = '<%= @feature.name %>';

        cacheBreakToggle.onchange = ({ target }) => {
            let maxPercent = target.checked ? Math.min(100, startingPercent + 20) : 100;
            let minPercent = target.checked ? Math.max(startingPercent - 20, 0) : 0;
            percentInput.max = maxPercent.toString();
            percentInput.min = minPercent.toString();
        };

        form.onsubmit = (e) => {
            const currentPercent = Number(percentInput.value);
            const cacheBreakEnabled = cacheBreakToggle.checked;
            
            // Permanent flags must explain why they are permanent
            if (permanentToggle.checked && descriptionInput.value.trim() === '') {
                alert('Permanent flags require a description. Please describe why this flag is permanent.');
                descriptionInput.focus();
                e.preventDefault();
                return false;
            }

            // Only show warning if percentage changed and cache break is enabled
            if (currentPercent !== startingPercent && cacheBreakEnabled) {
                const message = `Please allow 20 minutes between changes for caching to recover.\nAre you sure you want to update ${featureName} to ${currentPercent}%?`;
                if (!confirm(message)) {
                    e.preventDefault();
                    return false;
                }
            }
            return true;
        };
    };
</script>

<div class="max-w-2xl mx-auto">
  <div class="mb-4">
    <%= erb :"features/partials/back_link" %>
  </div>

  <%= erb :"features/partials/flash_messages" %>

  <div class="card">
    <div class="px-6 pt-6 pb-4">
      <h2 class="text-xl font-semibold text-gray-800 mb-1"><%= @feature.name %></h2>
      <p class="text-sm text-gray-500">Configure feature flag settings</p>
    </div>

    <div class="border-t border-gray-200"></div>

    <form id="updateFormSubmit" class="px-6 pt-6" action="<%= feature_path(@feature.name) %>" method="POST">
    <input type="hidden" name="last_updated_at" value="<%= @feature.data['updated_at'] %>">
    
    <div class="mb-6">
      <label class="block text-sm font-medium text-gray-700 mb-2" for="description">Description</label>
      <input class="form-input" name="description" id="description" value="<%= @feature.data['description'] %>" placeholder="Brief description of this feature flag">
    </div>

    <%= erb :"features/partials/team_input", locals: { current_team: @feature.data['team'].to_s } %>

    <%= erb :"features/partials/toggle_input", locals: { 
      name: 'consumer_cache_break', 
      label: 'Consumer Cache Break', 
      checked: @feature.data['consumer_cache_break'] == 'true',
      tooltip: 'cache_break_tooltip'
    } %>

    <%= erb :"features/partials/toggle_input", locals: {
      name: 'permanent',
      label: 'Permanent',
      checked: permanent?(@feature)
    } %>

    <div class="mb-6">
      <label class="block text-sm font-medium text-gray-700 mb-2" for="groups">
        Groups
        <span class="ml-1 text-gray-400 font-normal">(multi-select)</span>
      </label>
      <select class="form-input" name="groups[]" id="groups" multiple size="<%= rollout.groups.count + 1 %>">
        <option class="py-1 px-1" value="" <%= @feature.groups.count == 0 ? 'selected' : '' %>>
          (none)
        </option>
        <% rollout.groups.each do |group| %>
          <option class="py-1 px-1" value="<%= group %>" <%= @feature.groups.include?(group) ? 'selected' : '' %>>
            <%= group %>
          </option>
        <% end %>
      </select>
    </div>

    <div class="mb-6">
      <label class="block text-sm font-medium text-gray-700 mb-2" for="percentage">Percentage</label>
      <input class="form-input" name="percentage" id="percentage" value="<%= @feature.percentage %>" max="<%= get_high_percent_activate(@feature) %>" min="<%= get_low_percent_activate(@feature) %>" type="number" step="0.1">
    </div>

    <div>
      <label class="block text-sm font-medium text-gray-700 mb-2">Users</label>
      <% if @feature.users.count > 150 %>
        <div class="form-input bg-gray-50 text-gray-500">
          <%= @feature.users.count %> users
        </div>
      <% else %>
        <textarea class="form-input" name="users" id="users" rows="3" placeholder="Comma-separated user IDs"><%= @feature.users.join(', ') %></textarea>
      <% end %>
    </div>
  </form>

  <div class="flex items-center justify-between px-6 py-6 border-t border-gray-100">
    <form action="<%= delete_feature_path(@feature.name) %>" method="POST">
      <button class="text-sm px-5 py-3 font-semibold text-red-500 border border-red-500 hover:text-red-700 hover:border-red-700 hover:bg-red-50 rounded-lg transition-colors flex items-center gap-2" type="submit" onclick="return confirm('Are you sure you want to delete <%= @feature.name %>?')">
        <%= trash_icon %>
        Delete Feature
      </button>
    </form>
    <div class="flex items-center gap-3">
      <% if active_users_exporter_configured? %>
        <form action="<%= active_users_export_feature_path(@feature.name) %>" method="POST">
          <button class="btn-secondary" type="submit">
            <%= active_users_export_label %>
          </button>
        </form>
      <% end %>
      <button class="btn-primary" type="submit" form="updateFormSubmit">
        Update Feature
      </button>
    </div>
  </div>
  </div>

  <% history_events = has_logging? ? rollout.logging.events(@feature.name).reverse : [] %>

  <%= erb :"features/partials/event_log", locals: { events: history_events } %>
</div>
