<script>
    window.onload = () => {
        const percentInput = document.getElementById('percentage');
        const startingPercent = Number(percentInput.value);
        const cacheBreakToggle = document.getElementById('consumer_cache_break');

        cacheBreakToggle.onchange = ({ target }) => {
            let maxPercent = target.checked ? Math.min(100, startingPercent + 20) : 100;
            let minPercent = target.checked ? Math.max(startingPercent - 20, 0) : 0;
            percentInput.max = maxPercent.toString();
            percentInput.min = minPercent.toString();
        };
    };
</script>

<a class="text-sm text-blue-600 hover:text-blue-700 hover:underline" href="<%= index_path %>">
  &larr; back to overview
</a>

<% if params[:error] %>
  <pre class="text-red-500"><%= params[:error] %></pre>
<% end %>

<h2 class="font-semibold text-xl text-gray-500 pt-12">
  <%= @feature.name %>
</h2>

<div class="w-8 h-1 bg-gray-300 my-10"></div>

<main class="p-6 bg-gray-100 max-w-lg w-full text-sm rounded-sm">
  <form id="updateFormSubmit" action="<%= feature_path(@feature.name) %>" method="POST">
    <input type="hidden" name="last_updated_at" value="<%= @feature.data['updated_at'] %>">
    <div class="mb-5">
      <label class="block text-gray-500 mb-2" for="description">Description</label>
      <input class="appearance-none border rounded-sm w-full py-2 px-4 text-gray-600 leading-relaxed bg-white hover:border-gray-500" name="description" id="description" value="<%= @feature.data['description'] %>">
    </div>
    <div class="mb-5">
      <label class="block text-gray-500 mb-2" for="team">Team</label>
      <input class="appearance-none border rounded-sm w-full py-2 px-4 text-gray-600 leading-relaxed bg-white hover:border-gray-500" name="team" id="team" value="<%= @feature.data['team'] %>" placeholder="e.g. Platform, Consumer, Dashboard">
    </div>
    <div class="mb-5 flex items-center">
      <input name="consumer_cache_break" value="false" type="hidden">
      <input name="consumer_cache_break" id="consumer_cache_break" value="true" type="checkbox" <%= @feature.data['consumer_cache_break'] == 'true' ? 'checked' : '' %>>
      <label class="m-1 font-bold" for="consumer_cache_break">Consumer Cache Break</label>
      <div class="tooltip cursor-pointer">
        INFO?
        <div class="tooltip-text p-5 rounded bg-white shadow-xl" id="giant-popover">
          <p>
            Check this box if you <b>need</b> a consumer-side cache break on activation. A cache break may be unnecessary even
            if the flag is used on the consumer side.
          </p>
          <p class="text-md my-3">
            Example scenarios to determine need
          </p>
          <div>
            <ol class="list-decimal pl-6">
              <li class="mb-3">
                The flag is passed to the consumer side and you need the interface to update immediately on each restaurant's activation and you'll be activation slowly over time.
                <p>
                  <span class="font-bold text-green-700">Actions:</span> <b>CHECK THE BOX</b>, Update the percentage/ids/groups to what you need.<br>
                  Percentage cannot change by more that 20%, restaurants will update immediately
                </p>
              </li>
              <li>
                <p class="mb-2">
                  The flag is passed to the consumer side, you need to and are ready to activate to 100%
                </p>
                <p class="mb-2">
                  <span class="font-bold text-blue-700">Option A:</span> The interface update can wait until the next release (usually tomorrow AM)<br>
                  <span class="font-bold text-green-700">Actions:</span> <b>UNCHECK THE BOX</b>, update to 100%, wait for tomorrow morning's release.
                </p>
                <p>
                  <span class="font-bold text-blue-700">Option B:</span> It needs to activate and update consumer interface ASAP.<br>
                  <span class="font-bold text-green-700">Actions:</span> <b>CHECK THE BOX</b>, Increase the percentage by 20%, wait 20 minutes, repeat until 100% reached
                </p>
              </li>
            </ol>
          </div>
        </div>
      </div>
    </div>

    <div class="mb-5">
      <label class="block text-gray-500 mb-2" for="groups">
        Groups
        <span class="ml-1 text-gray-400">(multi-select)</span>
      </label>
      <select class="block appearance-none w-full bg-white border border-gray-300 px-4 py-3 rounded-sm leading-relaxed" name="groups[]" id="groups" multiple size="<%= @rollout.groups.count + 1 %>">
        <option class="py-1 px-1" value="" <%= @feature.groups.count == 0 ? 'selected' : '' %>>
          (none)
        </option>
        <% @rollout.groups.each do |group| %>
          <option class="py-1 px-1" value="<%= group %>" <%= @feature.groups.include?(group) ? 'selected' : '' %>>
            <%= group %>
          </option>
        <% end %>
      </select>
    </div>

    <div class="mb-5">
      <label class="block text-gray-500 mb-2" for="percentage">Percentage</label>
      <input class="appearance-none border rounded-sm w-full py-2 px-4 text-gray-600 leading-relaxed bg-white hover:border-gray-500" name="percentage" id="percentage" value="<%= @feature.percentage %>" max="<%= get_high_percent_activate(@feature) %>" min="<%= get_low_percent_activate(@feature) %>" type="number" step="0.1">
    </div>

    <div class="mb-5">
      <label class="block text-gray-500 mb-2">Users</label>

      <% if @feature.users.count > 150 %>
        <div class="appearance-none border rounded-sm w-full py-2 px-4 text-gray-600 leading-relaxed bg-gray-100">
          <%= @feature.users.count %>
        </div>
      <% else %>
        <textarea class="appearance-none border rounded-sm w-full py-2 px-4 text-gray-600 leading-relaxed bg-white hover:border-gray-500" name="users" id="users" rows="2"><%= @feature.users.join(', ') %></textarea>
      <% end %>
    </div>
  </form>

  <div class="flex items-center justify-end">
    <form action="<%= delete_feature_path(@feature.name) %>" method="POST">
      <button class="mr-5 text-gray-600 hover:underline" type="submit" onclick="return confirm('Are you sure you want to delete <%= @feature.name %>?')">
        Delete
      </button>
    </form>
    <button class="py-4 px-5 bg-gray-700 text-gray-200 rounded-sm font-bold leading-none transition-colors duration-200 hover:bg-gray-800" type="submit" form="updateFormSubmit">
      Update
    </button>
  </div>
</main>

<% history_events = @rollout.respond_to?(:logging) ? @rollout.logging.events(@feature.name).reverse : [] %>

<%= erb :"features/partials/event_log", locals: { events: history_events } %>

