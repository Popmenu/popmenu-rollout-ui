<h2 class="font-semibold text-xl text-gray-500 pt-12 flex items-center">
  <div class="flex-auto">
    Features
    <span class="text-sm p-1 bg-gray-100 ml-1 rounded-sm font-bold leading-none"><%= @features.count %></span>
  </div>

  <form class="flex-none" action="<%= new_feature_path %>" method="GET">
    <button class="text-sm text-gray-600 p-3 bg-gray-100 ml-1 rounded-sm font-bold leading-none transition-colors duration-150 hover:bg-gray-200" type="submit">
      Add New Feature
    </button>
  </form>
</h2>

<div class="w-8 h-1 bg-gray-300 my-10"></div>

<!-- View Toggle -->
<div class="flex items-center justify-end mb-6">
  <span class="text-sm text-gray-500 mr-3">View:</span>
  <div class="inline-flex rounded-lg border border-gray-200 p-1 bg-gray-50">
    <button 
      type="button" 
      id="team-view-btn"
      onclick="setView('team')"
      class="view-toggle-btn px-4 py-2 text-sm font-medium rounded-md transition-all duration-200"
    >
      <span class="flex items-center gap-2">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M2 3H6V7H2V3Z" stroke="currentColor" stroke-width="1.5"/>
          <path d="M10 3H14V7H10V3Z" stroke="currentColor" stroke-width="1.5"/>
          <path d="M2 9H6V13H2V9Z" stroke="currentColor" stroke-width="1.5"/>
          <path d="M10 9H14V13H10V9Z" stroke="currentColor" stroke-width="1.5"/>
        </svg>
        By Team
      </span>
    </button>
    <button 
      type="button" 
      id="list-view-btn"
      onclick="setView('list')"
      class="view-toggle-btn px-4 py-2 text-sm font-medium rounded-md transition-all duration-200"
    >
      <span class="flex items-center gap-2">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M2 4H14M2 8H14M2 12H14" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
        </svg>
        List
      </span>
    </button>
  </div>
</div>

<!-- List View -->
<div id="list-view" class="view-container hidden">
  <div class="overflow-auto scrolling-touch">
    <table class="text-sm w-100 text-left w-full">
      <thead class="font-semibold text-gray-500 border-b border-gray-200">
        <th class="pb-2 pr-3">Name</th>
        <th class="pb-2 pr-3">Team</th>
        <th class="pb-2 pr-3">Percentage</th>
        <th class="pb-2 pr-3">Groups</th>
        <th class="pb-2 pr-3">Users</th>
        <% if @rollout.respond_to?(:logging) %>
          <th class="pb-2 pr-3">Updated</th>
        <% end %>
        <th class="pb-2 pr-3">
          Consumer Cache Break
          <div class="pl-1 tooltip cursor-pointer">
            INFO?
            <div class="tooltip-text tooltip-text-low p-3 rounded bg-white w-56 shadow-xl">
              <span class="text-red-500">true</span> will break the consumer cache to update its content.<br>
              This results in a temporary increase in latency.
            </div>
          </div>
        </th>
        <th class="pl-2"></th>
      </thead>

      <tbody class="text-gray-600">
        <% @features.each do |feature_name| %>
          <% feature = @rollout.get(feature_name) %>
          <% has_cache_break = consumer_cache_break?(feature) %>
          <% activate_percentage = get_high_percent_activate(feature) %>
          <% deactivate_percentage = get_low_percent_activate(feature) %>

          <tr class="border-b border-gray-200">
            <td class="py-2">
              <a class="text-blue-600 hover:text-blue-700 hover:underline" href="<%= feature_path(feature.name) %>">
                <%= feature_name %>
              </a>
              <div class="text-gray-500 text-xs"><%= feature.data['description'] %></div>
            </td>
            <td class="py-2 whitespace-no-wrap">
              <% if feature.data['team'].to_s.strip.empty? %>
                <span class="text-gray-400">—</span>
              <% else %>
                <span class="text-xs px-2 py-1 bg-gray-100 rounded-full text-gray-600"><%= feature.data['team'] %></span>
              <% end %>
            </td>
            <td class="py-2 whitespace-no-wrap">
              <% if feature.percentage == 0 %>
                <span class="text-gray-400"><%= feature.percentage %>%</span>
              <% else %>
                <%= feature.percentage %>%
              <% end %>
            </td>
            <td class="py-2 whitespace-no-wrap">
              <%= feature.groups.join(', ') %>
            </td>
            <td class="py-2 whitespace-no-wrap">
              <% if feature.users.count == 0 %>
                <span class="text-gray-400"><%= feature.users.count %></span>
              <% else %>
                <%= feature.users.count %>
              <% end %>
            </td>
            <% if @rollout.respond_to?(:logging) %>
              <td class="py-2 whitespace-no-wrap">
                <%= time_ago(@rollout.logging.updated_at(feature_name)) %>
              </td>
            <% end %>
            <td class="py-2 whitespace-no-wrap <%= has_cache_break ? 'text-red-500' : 'text-green-500' %>">
              <%= feature.data['consumer_cache_break'] || 'false' %>
            </td>
            <td class="flex items-center py-2 justify-end whitespace-no-wrap pl-3">
              <form action="<%= activate_percentage_feature_path(feature_name, activate_percentage) %>" method="POST">
                <button class="p-3 ml-1 rounded-sm font-bold leading-none transition-colors duration-150 w-16 <%= has_cache_break ? 'bg-red-100 hover:bg-red-200' : 'bg-gray-100 hover:bg-gray-200' %>" type="submit" onclick="return confirm('<%= confirmation_message(feature, activate_percentage) %>')">
                  <%= activate_percentage %>%
                </button>
              </form>
              <form action="<%= activate_percentage_feature_path(feature_name, deactivate_percentage) %>" method="POST">
                <button class="p-3 ml-1 rounded-sm font-bold leading-none transition-colors duration-150 w-16 <%= has_cache_break ? 'bg-red-100 hover:bg-red-200' : 'bg-gray-100 hover:bg-gray-200' %>" type="submit" onclick="return confirm('<%= confirmation_message(feature, deactivate_percentage) %>')">
                  <%= deactivate_percentage %>%
                </button>
              </form>
              <form action="<%= delete_feature_path(feature_name) %>" method="POST">
                <button class="p-3 bg-gray-100 ml-1 rounded-sm font-bold leading-none transition-colors duration-150 hover:bg-gray-200" type="submit" onclick="return confirm('Are you sure you want to delete <%= feature_name %>?')">
                  Delete
                </button>
              </form>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>

<!-- Team View (Accordions) -->
<div id="team-view" class="view-container">
  <%
    # Group features by team
    features_by_team = @features.group_by do |feature_name|
      feature = @rollout.get(feature_name)
      feature.data['team'].to_s.strip.empty? ? 'Uncategorized' : feature.data['team']
    end
    
    # Sort teams alphabetically, but put Uncategorized at the end
    sorted_teams = features_by_team.keys.sort_by { |team| team == 'Uncategorized' ? 'zzz' : team.downcase }
  %>

  <div class="space-y-4">
    <% sorted_teams.each_with_index do |team, team_index| %>
      <% team_features = features_by_team[team] %>
      <div class="accordion-item border border-gray-200 rounded-lg overflow-hidden">
        <button 
          type="button" 
          class="accordion-header w-full flex items-center justify-between p-4 bg-gradient-to-r from-gray-50 to-gray-100 hover:from-gray-100 hover:to-gray-150 transition-all duration-200 cursor-pointer"
          onclick="toggleAccordion(this)"
          aria-expanded="true"
        >
          <div class="flex items-center gap-3">
            <span class="accordion-icon text-gray-400 transition-transform duration-300 transform rotate-90">
              <svg width="12" height="12" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M4.5 2L8.5 6L4.5 10" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </span>
            <span class="font-semibold text-gray-700 text-lg"><%= team %></span>
            <span class="text-xs px-2 py-1 bg-white rounded-full text-gray-500 font-medium shadow-sm"><%= team_features.count %> feature<%= team_features.count == 1 ? '' : 's' %></span>
          </div>
          <div class="accordion-toggle-text text-sm text-gray-400">
            Click to collapse
          </div>
        </button>
        
        <div class="accordion-content" style="max-height: 2000px; overflow: hidden; transition: max-height 0.3s ease-out;">
          <div class="overflow-auto scrolling-touch">
            <table class="text-sm w-100 text-left w-full">
              <thead class="font-semibold text-gray-500 border-b border-gray-200 bg-gray-50">
                <th class="py-3 px-4 pr-3">Name</th>
                <th class="py-3 pr-3">Percentage</th>
                <th class="py-3 pr-3">Groups</th>
                <th class="py-3 pr-3">Users</th>
                <% if @rollout.respond_to?(:logging) %>
                  <th class="py-3 pr-3">Updated</th>
                <% end %>
                <th class="py-3 pr-3">
                  Consumer Cache Break
                  <div class="pl-1 tooltip cursor-pointer">
                    INFO?
                    <div class="tooltip-text tooltip-text-low p-3 rounded bg-white w-56 shadow-xl">
                      <span class="text-red-500">true</span> will break the consumer cache to update its content.<br>
                      This results in a temporary increase in latency.
                    </div>
                  </div>
                </th>
                <th class="pl-2"></th>
              </thead>

              <tbody class="text-gray-600">
                <% team_features.each do |feature_name| %>
                  <% feature = @rollout.get(feature_name) %>
                  <% has_cache_break = consumer_cache_break?(feature) %>
                  <% activate_percentage = get_high_percent_activate(feature) %>
                  <% deactivate_percentage = get_low_percent_activate(feature) %>

                  <tr class="border-b border-gray-200 hover:bg-gray-50 transition-colors duration-150">
                    <td class="py-3 px-4">
                      <a class="text-blue-600 hover:text-blue-700 hover:underline font-medium" href="<%= feature_path(feature.name) %>">
                        <%= feature_name %>
                      </a>
                      <div class="text-gray-500 text-xs mt-1"><%= feature.data['description'] %></div>
                    </td>
                    <td class="py-3 whitespace-no-wrap">
                      <% if feature.percentage == 0 %>
                        <span class="text-gray-400"><%= feature.percentage %>%</span>
                      <% elsif feature.percentage == 100 %>
                        <span class="text-green-600 font-semibold"><%= feature.percentage %>%</span>
                      <% else %>
                        <span class="text-amber-600"><%= feature.percentage %>%</span>
                      <% end %>
                    </td>
                    <td class="py-3 whitespace-no-wrap">
                      <%= feature.groups.join(', ') %>
                    </td>
                    <td class="py-3 whitespace-no-wrap">
                      <% if feature.users.count == 0 %>
                        <span class="text-gray-400"><%= feature.users.count %></span>
                      <% else %>
                        <%= feature.users.count %>
                      <% end %>
                    </td>
                    <% if @rollout.respond_to?(:logging) %>
                      <td class="py-3 whitespace-no-wrap">
                        <%= time_ago(@rollout.logging.updated_at(feature_name)) %>
                      </td>
                    <% end %>
                    <td class="py-3 whitespace-no-wrap <%= has_cache_break ? 'text-red-500' : 'text-green-500' %>">
                      <%= feature.data['consumer_cache_break'] || 'false' %>
                    </td>
                    <td class="flex items-center py-3 justify-end whitespace-no-wrap pl-3 pr-4">
                      <form action="<%= activate_percentage_feature_path(feature_name, activate_percentage) %>" method="POST">
                        <button class="p-3 ml-1 rounded-sm font-bold leading-none transition-colors duration-150 w-16 <%= has_cache_break ? 'bg-red-100 hover:bg-red-200' : 'bg-gray-100 hover:bg-gray-200' %>" type="submit" onclick="return confirm('<%= confirmation_message(feature, activate_percentage) %>')">
                          <%= activate_percentage %>%
                        </button>
                      </form>
                      <form action="<%= activate_percentage_feature_path(feature_name, deactivate_percentage) %>" method="POST">
                        <button class="p-3 ml-1 rounded-sm font-bold leading-none transition-colors duration-150 w-16 <%= has_cache_break ? 'bg-red-100 hover:bg-red-200' : 'bg-gray-100 hover:bg-gray-200' %>" type="submit" onclick="return confirm('<%= confirmation_message(feature, deactivate_percentage) %>')">
                          <%= deactivate_percentage %>%
                        </button>
                      </form>
                      <form action="<%= delete_feature_path(feature_name) %>" method="POST">
                        <button class="p-3 bg-gray-100 ml-1 rounded-sm font-bold leading-none transition-colors duration-150 hover:bg-gray-200" type="submit" onclick="return confirm('Are you sure you want to delete <%= feature_name %>?')">
                          Delete
                        </button>
                      </form>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    <% end %>
  </div>
</div>

<% global_history_events = @rollout.respond_to?(:logging) ? @rollout.logging.global_events.reverse : [] %>

<%= erb :"features/partials/event_log", locals: { events: global_history_events, show_feature: true, show_header: true } %>

<script>
  function setView(view) {
    const listView = document.getElementById('list-view');
    const teamView = document.getElementById('team-view');
    const listBtn = document.getElementById('list-view-btn');
    const teamBtn = document.getElementById('team-view-btn');
    
    if (view === 'list') {
      listView.classList.remove('hidden');
      teamView.classList.add('hidden');
      listBtn.classList.add('bg-white', 'shadow-sm', 'text-gray-800');
      listBtn.classList.remove('text-gray-500');
      teamBtn.classList.remove('bg-white', 'shadow-sm', 'text-gray-800');
      teamBtn.classList.add('text-gray-500');
    } else {
      listView.classList.add('hidden');
      teamView.classList.remove('hidden');
      teamBtn.classList.add('bg-white', 'shadow-sm', 'text-gray-800');
      teamBtn.classList.remove('text-gray-500');
      listBtn.classList.remove('bg-white', 'shadow-sm', 'text-gray-800');
      listBtn.classList.add('text-gray-500');
    }
    
    // Save preference to localStorage
    localStorage.setItem('rollout-view-preference', view);
  }
  
  // Initialize view from localStorage on page load
  document.addEventListener('DOMContentLoaded', function() {
    const savedView = localStorage.getItem('rollout-view-preference') || 'team';
    setView(savedView);
  });
</script>
