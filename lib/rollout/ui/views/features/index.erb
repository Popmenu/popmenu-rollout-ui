<% if params[:success] %>
  <div class="flash-message mb-4 p-4 bg-emerald-50 border border-emerald-200 rounded-lg text-emerald-700 text-sm flex items-center justify-between">
    <span><%= params[:success] %></span>
    <button type="button" onclick="dismissFlash(this)" class="text-emerald-500 hover:text-emerald-700">
      <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M4 4L12 12M12 4L4 12" stroke-linecap="round"/>
      </svg>
    </button>
  </div>
<% end %>

<!-- Header Card -->
<div class="card p-6 mb-6">
  <div class="flex items-center justify-between">
    <div>
      <h2 class="text-xl font-semibold text-gray-800">Features</h2>
      <p class="text-sm text-gray-500 mt-1"><%= @features.count %> total features</p>
    </div>
    <form action="<%= new_feature_path %>" method="GET">
      <button class="btn-primary" type="submit">
        + Add New Feature
      </button>
    </form>
  </div>
</div>

<%= erb :"features/partials/view_toggle" %>

<%= erb :"features/partials/list_view" %>

<%= erb :"features/partials/team_view" %>

<% global_history_events = @rollout.respond_to?(:logging) ? @rollout.logging.global_events.reverse : [] %>

<%= erb :"features/partials/event_log", locals: { events: global_history_events, show_feature: true, show_header: true } %>
