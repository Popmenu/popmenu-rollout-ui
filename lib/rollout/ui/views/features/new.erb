<div class="flex justify-center">
  <div class="w-full max-w-lg">
  <%= erb :"features/partials/back_link" %>

    <%= erb :"features/partials/flash_messages" %>

    <div class="card mt-6">
      <div class="px-6 pt-6 pb-4">
        <h2 class="text-xl font-semibold text-gray-800 mb-1">New Feature</h2>
        <p class="text-sm text-gray-500">Create a new feature flag</p>
      </div>

      <div class="border-t border-gray-200"></div>

      <form class="p-6" action="<%= new_feature_path %>" method="POST">
        <div class="mb-6">
          <label class="block text-sm font-medium text-gray-700 mb-2" for="name">
            Feature Name <span class="text-red-500">*</span>
          </label>
          <input class="form-input" name="name" id="name" placeholder="e.g. new_checkout_flow" value="<%= params[:name] %>" required>
        </div>

        <%= erb :"features/partials/team_input", locals: { current_team: params[:team] } %>

        <div class="flex items-center justify-end pt-4 border-t border-gray-100">
          <button class="btn-primary" type="submit">Create Feature</button>
        </div>
      </form>
    </div>
  </div>
</div>
