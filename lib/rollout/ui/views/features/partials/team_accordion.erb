<%# locals: team_name, team_features %>
<%
  # Permanent flags stay in the table but are excluded from the header metrics
  permanent_features, non_permanent_features = team_features.partition { |feature| permanent?(feature) }
  permanent_count = permanent_features.length
  non_permanent_count = non_permanent_features.length
  fully_activated = non_permanent_features.count { |feature| feature.percentage == 100 }
%>
<div class="accordion-item" data-team="<%= team_name %>">
  <button 
    type="button" 
    class="accordion-header w-full flex items-center justify-between p-5 bg-white hover:bg-gray-50 transition-all duration-200 cursor-pointer rounded-lg"
    onclick="toggleAccordion(this)"
    aria-expanded="false"
  >
    <div class="flex items-center gap-3">
      <span class="accordion-icon text-gray-800 transition-transform duration-300 transform">
        <%= chevron_right_icon %>
      </span>
      <span class="font-semibold text-gray-800"><%= team_name %></span>
      <span class="text-xs px-2.5 py-1 rounded-full font-medium <%= feature_count_badge_classes(non_permanent_count) %>">
        <%= non_permanent_count %> non-permanent<% if non_permanent_count.positive? %> · <%= fully_activated %> fully activated<% end %>
      </span>
      <span class="text-xs px-2.5 py-1 bg-teal-100 rounded-full text-teal-700 font-medium"><%= permanent_count %> permanent</span>
    </div>
  </button>
  
  <div class="accordion-content" style="max-height: 0; transition: max-height 0.2s ease-out;">
    <div class="border-t border-gray-400">
      <table class="data-table">
        <%= erb :"features/partials/table_header", locals: { show_team: false, row_class: 'bg-gray-50' } %>

        <tbody class="overflow-clip rounded-b-lg">
          <% team_features.each do |feature| %>
            <%= erb :'features/partials/feature_row', locals: { feature: feature, show_team: false } %>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>
