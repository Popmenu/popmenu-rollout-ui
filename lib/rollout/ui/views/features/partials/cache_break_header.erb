<th>
  <span class="inline-flex items-center gap-2 relative">
    Cache Break
    <div class="info-tooltip">
      <span class="info-tooltip-trigger">
        <%= info_icon %>
      </span>
      <div class="info-tooltip-content" style="width: 240px;">
        <div class="font-medium text-gray-800 mb-2">Cache Break</div>
        <p class="text-gray-600 text-sm">
          When <span class="text-red-500 font-medium">true</span>, this will break the consumer cache to update its content.
        </p>
        <p class="text-gray-500 text-xs mt-2">
          This results in a temporary increase in latency.
        </p>
      </div>
    </div>
  </span>
</th>
