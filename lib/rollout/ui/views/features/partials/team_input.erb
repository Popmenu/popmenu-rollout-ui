<%# locals: current_team %>
<% current_team ||= '' %>

<div class="mb-6">
  <label class="block text-sm font-medium text-gray-700 mb-2" for="team">
    Team <span class="text-red-500">*</span>
  </label>
  <% if team_names.any? %>
    <select class="form-input" name="team" id="team" required onchange="toggleNewTeamInput(this)">
      <option value="">Select a team...</option>
      <% team_names.each do |team| %>
        <option value="<%= team %>" <%= current_team == team ? 'selected' : '' %>><%= team %></option>
      <% end %>
      <option value="__new__">+ Add new team...</option>
    </select>
    <input 
      class="form-input mt-2 hidden" 
      name="new_team" 
      id="new_team" 
      placeholder="Enter new team name"
      minlength="2"
    >
    <script>
      function toggleNewTeamInput(select) {
        const newTeamInput = document.getElementById('new_team');
        if (select.value === '__new__') {
          newTeamInput.classList.remove('hidden');
          newTeamInput.required = true;
          newTeamInput.focus();
        } else {
          newTeamInput.classList.add('hidden');
          newTeamInput.required = false;
          newTeamInput.value = '';
        }
      }
    </script>
  <% else %>
    <input class="form-input" name="team" id="team" value="<%= current_team %>" placeholder="e.g. Platform, Consumer, Dashboard" required minlength="2">
  <% end %>
</div>
