<%# locals: feature, feature_name, show_team %>
<% has_cache_break = consumer_cache_break?(feature) %>
<% activate_percentage = get_high_percent_activate(feature) %>
<% deactivate_percentage = get_low_percent_activate(feature) %>

<tr>
  <td>
    <a class="text-blue-600 hover:text-blue-700 font-medium" href="<%= feature_path(feature.name) %>">
      <%= feature_name %>
    </a>
    <% if !feature.data['description'].to_s.empty? %>
      <div class="text-gray-500 text-xs mt-1"><%= feature.data['description'] %></div>
    <% end %>
  </td>
  <% if show_team %>
    <td class="whitespace-nowrap">
      <% if feature.data['team'].to_s.strip.empty? %>
        <span class="text-gray-300">—</span>
      <% else %>
        <span class="text-xs px-2.5 py-1 bg-slate-100 rounded-full text-slate-600 font-medium"><%= feature.data['team'] %></span>
      <% end %>
    </td>
  <% end %>
  <td class="whitespace-nowrap">
    <% if feature.percentage == 0 %>
      <span class="text-gray-400"><%= feature.percentage %>%</span>
    <% elsif feature.percentage == 100 %>
      <span class="text-emerald-600 font-semibold"><%= feature.percentage %>%</span>
    <% else %>
      <span class="text-amber-600 font-medium"><%= feature.percentage %>%</span>
    <% end %>
  </td>
  <td class="whitespace-nowrap text-gray-500">
    <%= feature.groups.empty? ? '—' : feature.groups.join(', ') %>
  </td>
  <td class="whitespace-nowrap">
    <% if feature.users.count == 0 %>
      <span class="text-gray-300">0</span>
    <% else %>
      <span class="text-gray-600"><%= feature.users.count %></span>
    <% end %>
  </td>
  <% if @rollout.respond_to?(:logging) %>
    <td class="whitespace-nowrap text-gray-500">
      <%= time_ago(@rollout.logging.updated_at(feature_name)) %>
    </td>
  <% end %>
  <td class="whitespace-nowrap">
    <span class="text-xs px-2 py-1 rounded-full font-medium <%= has_cache_break ? 'bg-red-50 text-red-600' : 'bg-emerald-50 text-emerald-600' %>">
      <%= feature.data['consumer_cache_break'] || 'false' %>
    </span>
  </td>
  <td class="whitespace-nowrap text-right">
    <div class="flex items-center justify-end gap-2">
      <form action="<%= activate_percentage_feature_path(feature_name, activate_percentage) %>" method="POST" class="inline">
        <button class="btn-secondary text-xs px-3 py-1.5" type="submit" onclick="return confirm('<%= confirmation_message(feature, activate_percentage) %>')">
          <%= activate_percentage %>%
        </button>
      </form>
      <form action="<%= activate_percentage_feature_path(feature_name, deactivate_percentage) %>" method="POST" class="inline">
        <button class="btn-secondary text-xs px-3 py-1.5" type="submit" onclick="return confirm('<%= confirmation_message(feature, deactivate_percentage) %>')">
          <%= deactivate_percentage %>%
        </button>
      </form>
      <form action="<%= delete_feature_path(feature_name) %>" method="POST" class="inline">
        <button class="text-xs px-4 py-2 font-medium text-red-500 border border-red-500 hover:text-red-700 hover:border-red-700 hover:bg-red-50 rounded-lg transition-colors flex items-center gap-2" type="submit" onclick="return confirm('Are you sure you want to delete <%= feature_name %>?')">
          <%= trash_icon %>
          Delete
        </button>
      </form>
    </div>
  </td>
</tr>

