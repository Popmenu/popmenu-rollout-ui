<div class="info-tooltip">
  <span class="info-tooltip-trigger">
    <%= info_icon %>
  </span>
  <div class="info-tooltip-content">
    <div class="font-medium text-gray-800 mb-2">When to enable this</div>
    <p class="text-gray-600 text-sm mb-3">
      Enable if you need consumer-side cache to break on activation. This may be unnecessary even if the flag is used on the consumer side.
    </p>
    <div class="text-sm space-y-3">
      <div class="p-3 bg-amber-50 rounded-lg border border-amber-100">
        <div class="font-medium text-amber-700 mb-1">⚡ Gradual rollout</div>
        <p class="text-amber-600 text-xs">Enable this, then change percentage by max 20% at a time with 20 min between changes.</p>
      </div>
      <div class="p-3 bg-blue-50 rounded-lg border border-blue-100">
        <div class="font-medium text-blue-700 mb-1">🚀 Full activation (can wait)</div>
        <p class="text-blue-600 text-xs">Keep disabled, set to 100%, changes apply on next release.</p>
      </div>
      <div class="p-3 bg-emerald-50 rounded-lg border border-emerald-100">
        <div class="font-medium text-emerald-700 mb-1">⏱️ Full activation (immediate)</div>
        <p class="text-emerald-600 text-xs">Enable this, increase by 20% every 20 min until 100%.</p>
      </div>
    </div>
  </div>
</div>
