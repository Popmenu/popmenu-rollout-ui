<% show_feature ||= false %>
<% show_header ||= false %>

<% if events.any? %>
  <div class="mt-8">
    <h3 class="text-lg font-semibold text-gray-800 mb-4">History</h3>
    
    <div class="card overflow-hidden">
      <table class="data-table">
        <% if show_header %>
          <thead>
            <tr>
              <% if show_feature %>
                <th>Feature</th>
              <% end %>
              <th>Action</th>
              <th class="text-right">Time</th>
            </tr>
          </thead>
        <% end %>

        <tbody>
          <% events.each do |event| %>
            <tr>
              <% if show_feature %>
                <td class="whitespace-nowrap">
                  <a class="text-blue-600 hover:text-blue-700 font-medium" href="<%= feature_path(event.feature) %>">
                    <%= event.feature %>
                  </a>
                </td>
              <% end %>
              <td>
                <% if event.name == "update" %>
                  <span class="text-gray-600">
                    <% if event.context && event.context[:actor] %>
                      <% if config.defined?(:actor_url) %>
                        <a class="text-blue-600 hover:text-blue-700 font-medium" href="<%= config.get(:actor_url, event.context[:actor]) %>" target="_blank">
                          <%= event.context[:actor] %>
                        </a>
                      <% else %>
                        <span class="font-medium"><%= event.context[:actor] %></span>
                      <% end %>
                    <% else %>
                      <span class="text-gray-400">unidentified user</span>
                    <% end %>
                    <% changes = event.data.fetch(:before).keys.map do |key|
                      before = format_change_value(event.data.fetch(:before).fetch(key))
                      after = format_change_value(event.data.fetch(:after).fetch(key))
                      "#{format_change_key(key)} from #{before} to #{after}"
                    end %>
                    changed <%= changes.join(', ') %>
                  </span>
                <% else %>
                  <span class="text-gray-500"><%= event.data %></span>
                <% end %>
              </td>
              <td class="whitespace-nowrap text-right text-gray-400">
                <%= time_ago(event.created_at) %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
<% end %>
